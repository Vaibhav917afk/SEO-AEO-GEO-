AWA_HOST=127.0.0.1
AWA_PORT=8787
AWA_DRY_RUN=true
AWA_DATABASE=backend/data/agent.sqlite3
AWA_API_TOKEN=
AWA_AUTO_PUBLISH=false
AWA_ALLOWED_WORDPRESS_HOSTS=
AWA_MAX_REQUEST_BYTES=250000

WORDPRESS_BASE_URL=
WORDPRESS_USERNAME=
WORDPRESS_APP_PASSWORD=
WORDPRESS_SEO_PLUGIN=generic

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
ANTHROPIC_FALLBACK_MODELS=claude-opus-4-8,claude-haiku-4-5,claude-fable-5

# Optional live research for current-topic prompts.
# Without this, pasted source material and URLs still work.
AWA_ENABLE_LIVE_RESEARCH=false
AWA_WEB_SEARCH_PROVIDER=tavily
TAVILY_API_KEY=
